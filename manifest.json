const CONFIG = {
    name: "WeCima",
    id: "wecima",
    baseUrl: "https://wecima.cx"
};

// دالة عامة لجلب البيانات مع ترويسات صحيحة لتجنب الحظر
async function fetchData(url, options = {}) {
    if (!url) throw new Error("URL is empty");

    const response = await fetch(url, {
        ...options,
        headers: {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
            "Referer": CONFIG.baseUrl,
            ...(options.headers || {})
        }
    });

    if (!response.ok) {
        throw new Error(`HTTP Error: ${response.status}`);
    }

    return response;
}

// دالة البحث عن الأفلام والمسلسلات
async function search(query) {
    if (!query) return [];

    try {
        const searchUrl = `${CONFIG.baseUrl}/search/${encodeURIComponent(query)}`;
        const response = await fetchData(searchUrl);
        const html = await response.text();

        const results = [];
        
        // استخراج الروابط والعناوين وصور الغلاف من نتائج البحث
        const regex = /<div class="Thumb[\\s\\S]*?<a href="([^"]+)"[\\s\\S]*?<img[^>]+data-src="([^"]+)"[\\s\\S]*?<strong class="title">([^<]+)<\/strong>/g;
        
        let match;
        while ((match = regex.exec(html)) !== null) {
            results.push({
                url: match[1],
                poster: match[2],
                title: match[3].trim(),
                type: match[1].includes('/ser/') ? 'tv' : 'movie'
            });
        }

        return results;
    } catch (error) {
        console.error("WeCima Search Error:", error);
        return [];
    }
}

// دالة جلب تفاصيل العمل (الحلقات أو الفيلم)
async function getMediaDetails(url) {
    if (!url) return null;

    try {
        const response = await fetchData(url);
        const html = await response.text();

        // استخراج الوصف والعنوان والنوع
        return {
            title: "",
            poster: "",
            type: "movie",
            description: "",
            episodes: []
        };
    } catch (error) {
        console.error("WeCima Details Error:", error);
        return null;
    }
}

// دالة جلب روابط البث المباشر للفيديو
async function getStreams(videoUrl) {
    if (!videoUrl) return [];

    try {
        const response = await fetchData(videoUrl);
        const html = await response.text();

        const streams = [];

        // منطق استخراج روابط السيرفرات ومشغلات الفيديو
        // مثال توضيحي:
        /*
        streams.push({
            name: "WeCima - Server 1",
            title: "1080p",
            url: "رابط_الفيديو_المباشر",
            quality: "1080p",
            type: "m3u8"
        });
        */

        return streams;
    } catch (error) {
        console.error("WeCima Streams Error:", error);
        return [];
    }
}

module.exports = {
    search,
    getMediaDetails,
    getStreams
};
